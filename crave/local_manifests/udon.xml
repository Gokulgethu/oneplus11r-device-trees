<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest for OnePlus 11R 5G (udon / CPH2487, SM8475 / taro)
  Target: DerpFest 16.2  (Android 16, LineageOS 23.2 base)

    repo init -u https://github.com/DerpFest-AOSP/android_manifest.git -b 16.2 (with git-lfs)

  STATUS: BRING-UP IN PROGRESS. Read crave/README.md before building.
  Every <project> below was verified to exist at the stated revision.
-->
<manifest>

  <remote name="gh" fetch="https://github.com/" />

  <!-- ================= Device tree ================= -->

  <!-- This repository. -->
  <project name="Gokulgethu/oneplus11r-device-trees"
           path="device/oneplus/udon"
           remote="gh"
           revision="arena/01a04613-oneplus11r-device-trees" />

  <!--
    Common chipset tree.

    LineageOS/android_device_oneplus_sm8450-common is an EMPTY placeholder
    repo (0 bytes, no branches) and there is no LineageOS sm8475-common at
    all, so the only real tree is Teamslow's Android 13 one. It supplies the
    directories this device tree references but does not contain:
    bluetooth/include, sepolicy/, fingerprint/, KeyHandler, gpt-utils,
    interfaces/, oplus-fwk/, and the libinit_oplus_taro /
    libudfps_extension.oplus_taro Soong modules.

    It is Android 13 and WILL need forward-porting to 23.2.
  -->
  <project name="Teamslow/device_oneplus_sm8475-common"
           path="device/oneplus/sm8475-common"
           remote="gh"
           revision="13" />

  <!-- ================= Hardware HALs ================= -->

  <project name="LineageOS/android_hardware_oplus"
           path="hardware/oplus"
           remote="gh"
           revision="lineage-23.2" />

  <!-- ================= Kernel ================= -->

  <!--
    LineageOS/android_kernel_oneplus_sm8450 is actively maintained but tops
    out at lineage-22.2 (Android 15, 5.10 GKI). There is no 23.x branch.
    SM8475 is the same taro/waipio kernel family as SM8450, so this is the
    closest real source. Expect to fix up the defconfig and DTB target.
  -->
  <project name="LineageOS/android_kernel_oneplus_sm8450"
           path="kernel/oneplus/sm8475"
           remote="gh"
           revision="lineage-22.2" />

  <project name="LineageOS/android_kernel_oneplus_sm8450-devicetrees"
           path="kernel/oneplus/sm8450-devicetrees"
           remote="gh"
           revision="lineage-22.2" />

  <!-- ================= Proprietary blobs ================= -->

  <!--
    TheMuppets has no udon / CPH2487 vendor tree.

    Generate vendor/oneplus/{udon,sm8475-common} yourself from a CPH2487
    OxygenOS dump matching the fingerprint in lineage_udon.mk:

        cd device/oneplus/sm8475-common && ./extract-files.sh <path-to-dump>
        cd device/oneplus/udon          && ./extract-files.sh <path-to-dump>

    Teamslow/vendor_oneplus_2487 (branch "13") exists but carries Android 13
    blobs, which will not satisfy a 23.2 vendor interface.
  -->

</manifest>
